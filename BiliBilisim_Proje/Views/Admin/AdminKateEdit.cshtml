@model BiliBilisim_Proje.Models.kategori
@{
    ViewBag.Title = "Kategori Düzenle";
    Layout = "~/Views/Shared/_Admin.cshtml"; 
}

<div class="card shadow-sm border-0 col-md-8 mx-auto">
    <div class="card-header bg-white border-bottom pb-2 pt-3 d-flex justify-content-between align-items-center">
        <h5 class="text-warning mb-0"><i class="fas fa-edit me-2"></i>Kategori Düzenle</h5>
        <span class="badge bg-secondary">Kategori ID: @Model.kate_no</span>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("AdminKateEdit", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.kate_no)

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        <div class="row">
            <div class="col-12 mb-3">
                @Html.LabelFor(m => m.kate_adi, "Kategori Adı", new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.kate_adi, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.kate_adi, "", new { @class = "text-danger small" })
            </div>

            <div class="col-12 mb-4">
                <label class="form-label fw-bold">Üst Kategori</label>
                <select name="u_kate_id" class="form-select">
                    <option value="">Üst Kategori Seçiniz</option>

                    @if (ViewBag.UstKategoriListesi != null)
                    {
                        foreach (var item in (SelectList)ViewBag.UstKategoriListesi)
                        {
                            <option value="@item.Value" @(Model != null && Model.u_kate_id != null && Model.u_kate_id.ToString() == item.Value ? "selected" : "")>
                                @item.Text
                            </option>
                        }
                    }
                </select>

                @Html.ValidationMessageFor(m => m.u_kate_id, "", new { @class = "text-danger small" })
            </div>
        </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <a href="@Url.Action("AdminKateDelete", "Admin", new { id = Model.kate_no })" class="btn btn-outline-danger" onclick="return confirm('Bu kategoriyi silmek istediğinize emin misiniz? Alt kategorileri veya ürünleri varsa veri tabanı ilişkilerinden dolayı hata verebilir.');"><i class="fas fa-trash-alt me-1"></i> Kategoriyi Sil</a>

                <div>
                    <a href="@Url.Action("KategoriListele", "Admin")" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> İptal</a>
                    <button type="submit" class="btn btn-warning text-dark"><i class="fas fa-sync-alt me-1"></i> Güncelle</button>
                </div>
            </div>
        }
    </div>
</div>