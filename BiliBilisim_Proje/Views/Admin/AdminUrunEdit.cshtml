@model BiliBilisim_Proje.Models.urunler

@{
    ViewBag.Title = "Ürün Düzenle";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="card shadow-sm border-0 col-md-8 mx-auto mt-4">
    <div class="card-header bg-warning text-dark border-bottom pb-2 pt-3">
        <h5 class="mb-0"><i class="fas fa-edit me-2"></i>Ürün Düzenle</h5>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("AdminUrunEdit", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.urun_id)
            @Html.HiddenFor(m => m.fotolar)

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.urun_adi, "Ürün Adı", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.urun_adi, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.urun_adi, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Kategori</label>
                    <select name="kate_no" class="form-select" required>
                        <option value="">Kategori Seçiniz</option>
                        @if (ViewBag.KategoriListesi != null)
                        {
                            foreach (var item in (SelectList)ViewBag.KategoriListesi)
                            {
                                string seciliMi = "";
                                if (Model != null && Model.kate_no != null)
                                {
                                    if (Model.kate_no.ToString() == item.Value)
                                    {
                                        seciliMi = "selected";
                                    }
                                }
                                <option value="@item.Value" @seciliMi>@item.Text</option>
                            }
                        }
                    </select>
                    @Html.ValidationMessageFor(m => m.kate_no, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.marka, "Marka", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.marka, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.marka, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.model, "Model", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.model, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.model, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.fiyati, "Fiyat (₺)", new { @class = "form-label fw-bold" })
                    <input type="number" name="fiyati" value="@(Model != null ? Convert.ToInt32(Model.fiyati).ToString().Replace(",", ".") : "0")" class="form-control" step="0.01" min="0" required="required" />
                    @Html.ValidationMessageFor(m => m.fiyati, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.stok, "Stok Adedi", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.stok, new { @class = "form-control", type = "number", min = "0", required = "required" })
                    @Html.ValidationMessageFor(m => m.stok, "", new { @class = "text-danger small" })
                </div>
                <div class="col-12 mb-3">
                    <label class="form-label fw-bold">Mevcut Ürün Görseli</label>
                    <div class="mb-2">
                        @if (!string.IsNullOrEmpty(Model.fotolar))
                        {
                            <img src="~/Content/fotolar/@Model.fotolar" alt="" style="width: 80px; height: 80px; object-fit: cover;" class="rounded border" />
                        }
                        else
                        {
                            <span class="text-muted">Görsel yok</span>
                        }
                    </div>
                    <label class="form-label fw-bold">Yeni Görsel Seç (İsteğe Bağlı)</label>
                    <input type="file" name="dosya_adi" class="form-control" accept=".png, .jpg, .jpeg" />
                    @Html.ValidationMessage("fotolar", new { @class = "text-danger small d-block mt-1" })

                </div>
                <div class="col-12 mb-3">
                    @Html.LabelFor(m => m.urun_aciklama, "Ürün Açıklaması", new { @class = "form-label fw-bold" })
                    @Html.TextAreaFor(m => m.urun_aciklama, new { @class = "form-control", rows = "4" })
                    @Html.ValidationMessageFor(m => m.urun_aciklama, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-3">
                <a href="@Url.Action("UrunListele", "Admin")" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> Geri Dön</a>
                <button type="submit" class="btn btn-warning text-dark"><i class="fas fa-save me-1"></i> Güncelle</button>
            </div>
        }
    </div>
</div>