@using PagedList
@using PagedList.Mvc
@using System.Linq
@model IPagedList<IGrouping<string, BiliBilisim_Proje.Models.kategori>>

@{
    ViewBag.Title = "Kategori Listesi";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3 mt-3">
    <h4 class="m-0"><i class="fas fa-tags text-success me-2"></i>Kategori Yönetimi</h4>
    <a href="@Url.Action("Create")" class="btn btn-success btn-sm shadow-sm">
        <i class="fas fa-plus"></i> Yeni Kategori Ekle
    </a>
</div>

<div class="table-responsive shadow-sm" style="width: 100%; overflow-x: auto;">
    <table class="table table-bordered table-hover align-middle bg-white" style="table-layout: fixed; width: 100%; word-wrap: break-word;">
        <thead class="table-light">
            <tr>
                <th style="width: 75%;">Kategori Adı</th>
                <th class="text-center" style="width: 25%;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var grup in Model)
            {
                <tr class="table-dark">
                    <td colspan="2">
                        <i class="fas fa-folder-open me-2"></i>
                        <strong>Üst Kategori: @(string.IsNullOrEmpty(grup.Key) ? "Ana Kategori" : grup.Key)</strong>
                        <span class="text-light ms-2" style="font-size: 0.9em;">(@grup.Count() adet)</span>
                    </td>
                </tr>

                foreach (var item in grup)
                {
                    <tr>
                        @Html.Hidden("kate_no",item.kate_no)

                        <td>
                            <span class="d-block text-truncate text-dark fw-semibold">@item.kate_adi</span>
                        </td>

                        <td class="text-center">
                            <div class="btn-group shadow-sm w-100" role="group">
                                <a href="@Url.Action("AdminKateEdit", new { id = item.kate_no })" class="btn btn-sm btn-primary">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="@Url.Action("AdminKateDelete", new { id = item.kate_no })" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="mt-4 d-flex justify-content-center">
    @Html.PagedListPager(Model, sayfa => Url.Action("KategoriListele", new { sayfa }), new PagedListRenderOptions
    {
        Display = PagedListDisplayMode.IfNeeded,
        UlElementClasses = new[] { "pagination", "pagination-sm", "mb-0" },
        LiElementClasses = new[] { "page-item" }
    })
</div>