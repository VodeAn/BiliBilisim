@model BiliBilisim_Proje.Models.uyeler
@{
    ViewBag.Title = "Üye Düzenle";
    Layout = "~/Views/Shared/_Admin.cshtml"; // Layout yolunu kendi projenize göre güncelleyin
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-bottom pb-2 pt-3 d-flex justify-content-between align-items-center">
        <h5 class="text-warning mb-0"><i class="fas fa-user-edit me-2"></i>Üye Düzenle</h5>
        <span class="badge bg-secondary">Üye ID: @Model.uye_id</span>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("AdminUyeEdit", "Admin", FormMethod.Post))
        {
            <!-- Güncelleme işlemi için Primary Key gizli olarak taşınmalıdır -->
            @Html.HiddenFor(m => m.uye_id)

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.ad_soyad, "Ad Soyad", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.ad_soyad, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.ad_soyad, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.kuladi, "Kullanıcı Adı", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.kuladi, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.kuladi, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.email, "E-Posta Adresi", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.email, new { @class = "form-control", type = "email" })
                    @Html.ValidationMessageFor(m => m.email, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.sifre, "Şifre", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.sifre, new { @class = "form-control" })
                    <small class="text-muted">Şifreyi değiştirmek istemiyorsanız mevcut şifreyi bırakın.</small>
                    @Html.ValidationMessageFor(m => m.sifre, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-4 mb-3">
                    @Html.LabelFor(m => m.dog_tar, "Doğum Tarihi", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.dog_tar, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.dog_tar, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-4 mb-3">
                    @Html.LabelFor(m => m.cinsiyet, "Cinsiyet", new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(m => m.cinsiyet, new SelectList(new[] { "Erkek", "Kadın" }, Model.cinsiyet), "Seçiniz", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.cinsiyet, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-4 mb-3">
                    @Html.LabelFor(m => m.plaka, "Şehir (Plaka)", new { @class = "form-label fw-bold" })
                    @Html.DropDownList("plaka", null, "Şehir Seçiniz", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.plaka, "", new { @class = "text-danger small" })
                </div>

                <div class="col-12 mb-3">
                    @Html.LabelFor(m => m.adres, "Adres", new { @class = "form-label fw-bold" })
                    @Html.TextAreaFor(m => m.adres, new { @class = "form-control", rows = "3" })
                    @Html.ValidationMessageFor(m => m.adres, "", new { @class = "text-danger small" })
                </div>

                <div class="col-12 mb-4 form-check ms-2">
                    @Html.CheckBoxFor(m => m.vip, new { @class = "form-check-input" })
                    @Html.LabelFor(m => m.vip, "Bu Kullanıcı Bayi Üyesi Mi?", new { @class = "form-check-label fw-bold" })
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <a href="@Url.Action("AdminUyeDelete", "Admin", new { id = Model.uye_id })" class="btn btn-outline-danger" onclick="return confirm('Bu üyeyi silmek istediğinize emin misiniz?');"><i class="fas fa-trash-alt me-1"></i> Üyeyi Sil</a>
                <div>
                    <a href="@Url.Action("UyeListele", "Admin")" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> İptal</a>
                    <button type="submit" class="btn btn-warning text-dark"><i class="fas fa-sync-alt me-1"></i> Güncelle</button>
                </div>
            </div>
        }
    </div>
</div>