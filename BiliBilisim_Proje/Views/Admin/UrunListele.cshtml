@using PagedList
@using PagedList.Mvc
@using System.Linq
@model IPagedList<IGrouping<string, BiliBilisim_Proje.Models.urunler>>

@{
    ViewBag.Title = "Ürün Listesi";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3 mt-3">
    <h4 class="m-0"><i class="fas fa-box text-warning me-2"></i>Ürün Yönetimi</h4>
    <a href="@Url.Action("Create")" class="btn btn-success btn-sm shadow-sm">
        <i class="fas fa-plus"></i> Yeni Ürün Ekle
    </a>
</div>
<div class="table-responsive shadow-sm" style="width: 100%; overflow-x: auto;">
    <table class="table table-bordered table-hover align-middle bg-white" style="table-layout: fixed; width: 100%; word-wrap: break-word;">
        <thead class="table-light">
            <tr>
                <th class="text-center" style="width: 8%;">Görsel</th>
                <th style="width: 25%;">Ürün Adı & Açıklama</th>
                <th style="width: 15%;">Marka / Model</th>
                <th class="text-end" style="width: 10%;">Fiyat</th>
                <th class="text-center" style="width: 10%;">Stok</th>
                <th class="text-center" style="width: 8%;">Satış</th>
                <th class="text-center" style="width: 12%;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var grup in Model)
            {
                <tr class="table-dark">
                    <td colspan="7">
                        <i class="fas fa-layer-group me-2"></i>
                        <strong>Kategori: @grup.Key</strong>
                    </td>
                </tr>
                foreach (var item in grup)
                {
                    <tr>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(item.fotolar))
                            {
                                <img src="~/Content/fotolar/@item.fotolar" alt="@item.urun_adi" class="img-thumbnail p-0" style="width: 40px; height: 40px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-light text-muted d-flex align-items-center justify-content-center border rounded" style="width: 40px; height: 40px; margin: 0 auto;">
                                    <i class="fas fa-image"></i>
                                </div>
                            }
                        </td>

                        <td>
                            <strong class="text-dark d-block">@item.urun_adi</strong>
                            <small class="text-muted d-block mt-1">
                                @item.urun_aciklama
                            </small>
                        </td>
                        <td>
                            <span class="d-block fw-semibold">@item.marka</span>
                            <small class="text-muted d-block">@item.model</small>
                        </td>
                        <td class="text-end text-success fw-bold">
                            @item.fiyati ₺
                        </td>

                        <td class="text-center">
                            @if (item.stok > 10)
                            {
                                <span class="badge bg-success">@item.stok</span>
                            }
                            else if (item.stok > 0)
                            {
                                <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-triangle"></i> Son @item.stok</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Tükendi</span>
                            }
                        </td>

                        <td class="text-center">
                            <span class="badge bg-info text-dark">@item.satis_adet</span>
                        </td>

                        <td class="text-center">
                            <div class="btn-group shadow-sm w-100" role="group">
                                <a href="@Url.Action("AdminUrunEdit", new { id = item.urun_id })" class="btn btn-sm btn-primary">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="@Url.Action("AdminUrunDelete", new { id = item.urun_id })" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<div class="mt-4 d-flex justify-content-center">
    @Html.PagedListPager(Model, sayfa => Url.Action("UrunListele", new { sayfa }), new PagedListRenderOptions
    {
        Display = PagedListDisplayMode.IfNeeded,
        UlElementClasses = new[] { "pagination", "pagination-sm", "mb-0" },
        LiElementClasses = new[] { "page-item" }
    })
</div>