@model BiliBilisim_Proje.Models.uyeler

@{
    ViewBag.Title = "Edit";
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.uye_id)

        <div class="form-group">
            @Html.Label("Kullanıcı Adı", "Kullanıcı Adı", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.kuladi, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.kuladi, "", new { @class = "text-danger", @readonly = "readonly" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Şifre", "Şifre", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.sifre, new { htmlAttributes = new { @class = "form-control", @type = "password" } })
                @Html.ValidationMessageFor(model => model.sifre, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            <label>Şifreyi Doğrula</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.sifre, new { htmlAttributes = new { @class = "form-control", @type = "password" } })
                @Html.ValidationMessage("confirm", "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Ad Soyad", "Ad Soyad", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.ad_soyad, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ad_soyad, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Doğum Tarihi", "Doğum Tarihi", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBox("dog_tar",Model.dog_tar.ToShortDateString(), new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.dog_tar, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-12 mb-20">
                <label class="d-block">Cinsiyet</label>
                <div class="d-flex align-items-center gap-3">
                    <label class="d-inline-flex align-items-center gap-1 cursor-pointer">
                        @Html.RadioButton("cinsiyet", false)
                        <span>Erkek</span>
                    </label>
                    <label class="d-inline-flex align-items-center gap-1 cursor-pointer">
                        @Html.RadioButton("cinsiyet", true)
                        <span>Kadın</span>
                    </label>
                </div>
                @Html.ValidationMessage("cinsiyet", "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-12 mb-20">
                <div class="d-flex align-items-center gap-3">
                    <label class="d-inline-flex align-items-center gap-1 cursor-pointer">
                        @Html.CheckBox("vip", new { @readonly="readonly" })<b> VIP</b>
                       
                    </label>
                </div>
                @Html.ValidationMessage("cinsiyet", "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Adres", "Adres", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextAreaFor(model => model.adres, 5, 30, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.adres, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Email", "Email", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.email, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.email, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("İller", "İller", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("plaka", null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.plaka, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Kaydet" class="btn btn-default" />
            </div>
        </div>
    </div>
}


