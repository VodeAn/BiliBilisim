<div class="contact-main-page mt-60 mb-40 mb-md-40 mb-sm-40 mb-xs-40">
    <!-- Harita Alanı -->
    <div class="container mb-60">
        <!-- Genişlik ve yükseklik değerleri düzeltildi -->
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3044.373443492444!2d29.082133599999995!3d40.26745390000001!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14ca40653791a2d5%3A0xd25ecfe140a173f2!2sBUTGEM%20BTSO%20E%C4%9Fitim%20Vakf%C4%B1!5e0!3m2!1str!2str!4v1785759481919!5m2!1str!2str"
                width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin">
        </iframe>
    </div>

    <div class="container">
        <div class="row">
            <!-- Sol Taraf: İletişim Formu -->
            <div class="col-lg-6 col-md-12 order-2 order-lg-1">
                <div class="contact-form-content pt-sm-55 pt-xs-55">
                    <h3 class="contact-page-title">Önerilerinizi Yazın</h3>
                    <div class="contact-form">
                        <form id="contact-form" action="@Url.Action("MailGonder")" method="post">
                            <div class="form-group">
                                <label>Adınız Soyadınız <span class="required">*</span></label>
                                <input type="text" name="customerName" id="customername" required>
                            </div>
                            <div class="form-group">
                                <label>Mail Adresiniz <span class="required">*</span></label>
                                <input type="email" name="customerEmail" id="customerEmail" required>
                            </div>
                            <div class="form-group">
                                <label>Konu Başlığı</label>
                                <input type="text" name="contactSubject" id="contactSubject">
                            </div>
                            <div class="form-group mb-30">
                                <label>Mesajınız</label>
                                <textarea name="contactMessage" id="contactMessage" rows="5"></textarea>
                            </div>
                            <div class="form-group">
                                <button type="submit" id="submit" class="li-btn-3">Gönder</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Sağ Taraf: İletişim Bilgileri -->
            <div class="col-lg-5 offset-lg-1 col-md-12 order-1 order-lg-2">
                <div class="contact-page-side-content">
                    <h3 class="contact-page-title">Bize Ulaşın</h3>
                    <p class="contact-page-message mb-25"><b>BUTGEM BTSO Eğitim Vakfı</b></p>
                    <div class="single-contact-block">
                        <!-- fa-fax ikonu fa-map-marker ile değiştirildi -->
                        <h4><i class="fa fa-map-marker"></i> Adres</h4>
                        <p>DOSAB, Mustafa Karaer Caddesi, Çiğdem 2 Sokak No:1, 16245 Osmangazi/Bursa</p>
                    </div>
                    <div class="single-contact-block">
                        <h4><i class="fa fa-phone"></i> İletişim</h4>
                        <p>Telefon: +90 (224) 261 12 11</p>
                        <p>Faks: +90 (224) 261 12 11</p>
                    </div>
                    <div class="single-contact-block last-child">
                        <h4><i class="fa fa-envelope-o"></i> Email</h4>
                        <p>butgem@butgem.org.tr</p>
                        <p>kurumsal@butgem.org.tr</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>