@model IPagedList<BiliBilisim_Proje.Models.urunler>
@using PagedList;
@using PagedList.Mvc;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row">
    <div class="col-lg-9 order-1 order-lg-2">
        <!-- shop-top-bar start -->
        <div class="shop-top-bar mt-30">
            <div class="shop-bar-inner">
                <div class="product-view-mode">
                </div>
                <div class="toolbar-amount">
                    @if (Model != null && Model.TotalItemCount > 0)
                    {
                        var baslangic = ((Model.PageNumber - 1) * Model.PageSize) + 1;
                        var bitis = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalItemCount);

                        <span>@Model.TotalItemCount adet sonuç arasından @baslangic-@bitis arası gösteriliyor. </span>
                    }
                    else
                    {
                        <span>Ürün bulunamadı.</span>
                    }
                </div>
            </div>
            <!-- product-select-box start -->
            <div class="product-select-box">
                <div class="product-short">
                    <p>Sıralama:</p>
                    @using (Html.BeginForm())
                    {
                        @Html.DropDownList("filtre", null, "Seçiniz", new { @class = "nice-select", onchange = "this.form.submit()" })
                    }
                </div>
            </div>
            <!-- product-select-box end -->
        </div>
        <!-- shop-top-bar end -->
        <!-- shop-products-wrapper start -->
        <div class="shop-products-wrapper">
            <div class="tab-content">
                <div id="grid-view" class="tab-pane fade active show" role="tabpanel">
                    <div class="product-area shop-product-area">
                        <div class="row">
                            @{var favoriModel = Session["favoriler"] as BiliBilisim_Proje.Models.Favoriler;}

                            @foreach (var item in Model)
                            {
                                bool favorideMi = favoriModel != null
                                    && favoriModel.Favorilerim != null
                                    && favoriModel.Favorilerim.Any(x => x.urun_id == item.urun_id);

                                <div class="col-lg-4 col-md-4 col-sm-6 mt-40">
                                    <!-- single-product-wrap start -->
                                    <div class="single-product-wrap">
                                        <div class="product-image">
                                            <a href="@Url.Action("details", new { id = item.urun_id, kateno = item.kategori.u_kate_id })">
                                                <img src="~/Content/fotolar/@item.fotolar" alt="">
                                            </a>
                                            <span class="sticker">New</span>
                                        </div>
                                        <div class="product_desc">
                                            <div class="product_desc_info">
                                                <div class="product-review">
                                                    <div class="rating-box">
                                                        <ul class="rating">
                                                            <li><i class="fa fa-star-o"></i></li>
                                                            <li><i class="fa fa-star-o"></i></li>
                                                            <li><i class="fa fa-star-o"></i></li>
                                                            <li class="no-star"><i class="fa fa-star-o"></i></li>
                                                            <li class="no-star"><i class="fa fa-star-o"></i></li>
                                                        </ul>
                                                    </div>
                                                </div>
                                                <h4><a class="product_name" href="@Url.Action("details", new { id = item.urun_id, kateno = item.kategori.u_kate_id })">@Html.DisplayFor(modelItem => item.urun_adi)</a></h4>
                                                <div class="price-box">
                                                    <span class="new-price">@Html.DisplayFor(modelItem => item.fiyati)₺</span>
                                                </div>
                                            </div>
                                            @{
                                                var uye = Session["uye"] as BiliBilisim_Proje.Models.uyeler;
                                                if (uye != null && uye.vip)
                                                {
                                                    <div class="add-actions">
                                                        <ul class="add-actions-link">
                                                            @if (item.stok > 0)
                                                            {
                                                                <li class="add-cart active"><a href="@Url.Action("sepete_ekle", "sepet", new { id = item.urun_id })">Sepete Ekle</a></li>
                                                            }
                                                            else
                                                            {
                                                                <b style="color:#fed700;">Stok Tükendi</b>
                                                            }
                                                            <li>
                                                                <a class="links-details"
                                                                   href="@Url.Action("favorilere_ekle", "favoriler", new { id = item.urun_id })"
                                                                   onclick="favoriEkle(event, this)">
                                                                    <i class="fa @(favorideMi ? "fa-heart" : "fa-heart-o")"></i>
                                                                </a>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <!-- single-product-wrap end -->
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div style="margin-top:50px; margin-bottom:50px;" class="d-flex justify-content-center">
                    @Html.PagedListPager(Model, sayfa => Url.Action("Index", new
               {
                   sayfa,
                   ustId = ViewBag.ustId,
                   altId = ViewBag.altId,
                   filtre = ViewBag.filtre
               }), new PagedListRenderOptions
               {
                   Display = PagedListDisplayMode.IfNeeded,
                   UlElementClasses = new[] { "pagination pagination-sm" },
                   LiElementClasses = new[] { "page-item" }
               })
                </div>
            </div>
        </div>
        <!-- shop-products-wrapper end -->
    </div>
    <div class="col-lg-3 order-2 order-lg-1">
        <!--sidebar-categores-box start -->
        <div class="sidebar-categores-box">
            <div class="sidebar-title">
                <h2>Kategoriler</h2>
            </div>

            <!-- Tüm Filtreleri Temizle -->
            <a href="@Url.Action("Index")" class="btn-clear-all mb-sm-30 mb-xs-30" style="display:block; text-align:center; padding: 10px; background:#f7f7f7; color:#333;">Tümünü Temizle</a>
            
            <div class="filter-sub-area pt-sm-10 pt-xs-10">
                <div class="categori-checkbox">
                    <ul>
                        @{
                            var anaKategoriler = ViewBag.AnaKategoriler as List<BiliBilisim_Proje.Models.ust_kategori>;
                            var altKategoriler = ViewBag.AltKategoriler as List<BiliBilisim_Proje.Models.kategori>;

                            if (anaKategoriler != null && altKategoriler != null)
                            {
                                foreach (var ana in anaKategoriler)
                                {
                                    <li style="margin-bottom: 12px;">
                                        <a href="@Url.Action("Index", new { ustId = ana.u_kate_id })" style="font-weight: bold; color: #333;">
                                            @ana.u_kate_adi
                                        </a>
                                        <ul style="padding-left: 15px; margin-top: 5px;">
                                            @foreach (var alt in altKategoriler.Where(x => x.u_kate_id == ana.u_kate_id))
                                            {
                                                <li>
                                                    <a href="@Url.Action("Index", new { altId = alt.kate_no })" style="color: #666;">
                                                        - @alt.kate_adi
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </li>
                                }
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>
        <!--sidebar-categores-box end -->
    </div>
</div>


<style>
    /* 1. Kartı dikey flex yapıp tam boya zorluyoruz */
    .single-product-wrap {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    /* 2. Resim alanına SABİT YÜKSEKLİK verip içindekileri ortalıyoruz */
    .product-image {
        height: 280px; /* Tüm resim kutuları kesinlikle 280px olacak */
        width: 100%;
        display: flex;
        align-items: center; /* Dikeyde ortalar */
        justify-content: center; /* Yatayda ortalar */
        position: relative;
        overflow: hidden;
    }

        .product-image a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
        }

        /* 3. Resimlerin 280px dışına taşmasını engelliyor ve oranını koruyoruz */
        .product-image img {
            max-width: 100%;
            max-height: 100%;
            width: auto;
            height: auto;
            object-fit: contain;
        }

    /* 4. Alt bilgileri (başlık, fiyat, butonlar) kartın en altına hizalıyoruz */
    .product_desc {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        justify-content: space-between;
    }
    /* --- SAYFALAMA AKTİF SAYFA KESİN ÇÖZÜM --- */

    .pagination {
        display: flex;
        padding-left: 0;
        list-style: none;
        gap: 6px;
        justify-content: center;
        margin-top: 30px;
    }

        /* Normal Butonlar (Pasif) */
        .pagination li a,
        .pagination li span {
            display: block;
            padding: 8px 14px;
            color: #000000;
            background-color: #ffffff;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            text-decoration: none;
            font-weight: 600;
        }

            /* Üzerine Gelince (Hover) */
            .pagination li a:hover {
                color: #000000;
                background-color: #ffc107;
                border-color: #ffc107;
            }

        /* AKTİF SAYFA (Hangi sayfadaysan burası çalışır) */
        .pagination > .active > span,
        .pagination > .active > a,
        .pagination li.active span,
        .pagination li.active a {
            background-color: #ffc107 !important; /* Canlı Sarı */
            color: #000000 !important; /* Siyah Metin */
            border-color: #ffc107 !important; /* Sarı Kenarlık */
            font-weight: bold !important;
            box-shadow: 0 2px 6px rgba(255, 193, 7, 0.4);
            pointer-events: none;
            Tıklanamaz yapar
        }

        /* Pasif Oklar */
        .pagination li.disabled span {
            color: #6c757d;
            background-color: #f8f9fa;
            border-color: #dee2e6;
            opacity: 0.6;
        }
</style>