@model IPagedList<BiliBilisim_Proje.Models.urunler>
@using PagedList;
@using PagedList.Mvc;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row">
    <div class="col-lg-9 order-1 order-lg-2">
        <!-- shop-top-bar start -->
        <div class="shop-top-bar mt-30">
            <div class="shop-bar-inner">
                <div class="product-view-mode">
                    <!-- shop-item-filter-list start -->
                    <!-- shop-item-filter-list end -->
                </div>
                <div class="toolbar-amount">
                    <span>Showing 1 to 9 of 15</span><!-- düzeltilecekkkkk -->
                </div>
            </div>
            <!-- product-select-box start -->
            <div class="product-select-box">
                <div class="product-short">
                    <p>Sıralama:</p>
                    @using (Html.BeginForm())
                    {
                        @Html.DropDownList("filtre", null, "Seçiniz", new { @class = "nice-select", onchange = "this.form.submit()" })
                    }
                </div>
            </div>
            <!-- product-select-box end -->
        </div>
        <!-- shop-top-bar end -->
        <!-- shop-products-wrapper start -->
        <div class="shop-products-wrapper">
            <div class="tab-content">
                <div id="grid-view" class="tab-pane fade active show" role="tabpanel">
                    <div class="product-area shop-product-area">
                        <div class="row">
                            @{ var liste = Model.Take(3);}
                            @foreach (var item in liste)
                            {
                                <div class="col-lg-4 col-md-4 col-sm-6 mt-40">
                                    <!-- single-product-wrap start -->
                                    <div class="single-product-wrap">
                                        <div class="product-image">
                                            <a href="@Url.Action("details",new {id=item.urun_id})">
                                                <img src="~/Content/fotolar/@item.fotolar" alt="">
                                            </a>
                                            <span class="sticker">New</span>
                                        </div>
                                        <div class="product_desc">
                                            <div class="product_desc_info">
                                                <div class="product-review">
                                                    <div class="rating-box">
                                                        <ul class="rating">
                                                            <li><i class="fa fa-star-o"></i></li>
                                                            <li><i class="fa fa-star-o"></i></li>
                                                            <li><i class="fa fa-star-o"></i></li>
                                                            <li class="no-star"><i class="fa fa-star-o"></i></li>
                                                            <li class="no-star"><i class="fa fa-star-o"></i></li>
                                                        </ul>
                                                    </div>
                                                </div>
                                                <h4><a class="product_name" href="@Url.Action("details",new {id=item.urun_id})">@Html.DisplayFor(modelItem => item.urun_adi)</a></h4>
                                                <div class="price-box">
                                                    <span class="new-price">@Html.DisplayFor(modelItem => item.fiyati)₺</span>
                                                </div>
                                            </div>
                                            @{
                                                var uye = Session["uye"] as BiliBilisim_Proje.Models.uyeler;
                                                if (uye != null && uye.vip)
                                                {


                                                    <div class="add-actions">
                                                        <ul class="add-actions-link">
                                                            <li class="add-cart active"><a href="@Url.Action("sepete_ekle","sepet",new {id = item.urun_id })">Sepete Ekle</a></li>
                                                            <li>
                                                                @{
                                                                    var favoriModel = Session["favoriler"] as BiliBilisim_Proje.Models.Favoriler;
                                                                    bool favorideMi = favoriModel != null
                                                                                      && favoriModel.Favorilerim != null
                                                                                      && favoriModel.Favorilerim.Any(x => x.urun_id == item.urun_id);
                                                                }

                                                                <a class="links-details"
                                                                   href="@Url.Action("favorilere_ekle", "favoriler", new { id = item.urun_id })"
                                                                   onclick="favoriEkle(event, this)">
                                                                    <i class="fa @(favorideMi ? "fa-heart" : "fa-heart-o")"></i>
                                                                </a>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <!-- single-product-wrap end -->
                                </div>
                            }
                            @{ liste = Model.Skip(3).Take(3);}
                            @foreach (var item in liste)
                            {
                                <div class="col-lg-4 col-md-4 col-sm-6 mt-40">
                                    <!-- single-product-wrap start -->
                                    <div class="single-product-wrap">
                                        <div class="product-image">
                                            <a href="@Url.Action("details", new { id = item.urun_id })">
                                                <img src="~/Content/fotolar/@item.fotolar" alt="">
                                            </a>
                                            <span class="sticker">New</span>
                                        </div>
                                        <div class="product_desc">
                                            <div class="product_desc_info">
                                                <div class="product-review">
                                                    <div class="rating-box">
                                                        <ul class="rating">
                                                            <li><i class="fa fa-star-o"></i></li>
                                                            <li><i class="fa fa-star-o"></i></li>
                                                            <li><i class="fa fa-star-o"></i></li>
                                                            <li class="no-star"><i class="fa fa-star-o"></i></li>
                                                            <li class="no-star"><i class="fa fa-star-o"></i></li>
                                                        </ul>
                                                    </div>
                                                </div>
                                                <h4><a class="product_name" href="@Url.Action("details", new { id = item.urun_id })">@Html.DisplayFor(modelItem => item.urun_adi)</a></h4>
                                                <div class="price-box">
                                                    <span class="new-price">@Html.DisplayFor(modelItem => item.fiyati)₺</span>
                                                </div>
                                            </div>
                                            @{
                                                var uye = Session["uye"] as BiliBilisim_Proje.Models.uyeler;
                                                if (uye != null && uye.vip)
                                                {
                                                    <div class="add-actions">
                                                        <ul class="add-actions-link">
                                                            <li class="add-cart active"><a href="@Url.Action("sepete_ekle", "sepet",new {id = item.urun_id })">Sepete Ekle</a></li>
                                                            <li>
                                                                @{
                                                                    var favoriModel = Session["favoriler"] as BiliBilisim_Proje.Models.Favoriler;
                                                                    bool favorideMi = favoriModel != null
                                                                                      && favoriModel.Favorilerim != null
                                                                                      && favoriModel.Favorilerim.Any(x => x.urun_id == item.urun_id);
                                                                }

                                                                <a class="links-details"
                                                                   href="@Url.Action("favorilere_ekle", "favoriler", new { id = item.urun_id })"
                                                                   onclick="favoriEkle(event, this)">
                                                                    <i class="fa @(favorideMi ? "fa-heart" : "fa-heart-o")"></i>
                                                                </a>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                }
                                            }

                                        </div>
                                    </div>
                                    <!-- single-product-wrap end -->
                                </div>
                            }

                        </div>
                    </div>
                </div>
                <div style="margin-top:100px;float:right" class="d-flex justify-content-center">
                    @Html.PagedListPager(Model, sayfa => Url.Action("index", new { sayfa, filtre = Session["filtre"] }), new PagedListRenderOptions
                    {
                        Display = PagedListDisplayMode.IfNeeded,
                        UlElementClasses = new[] { "pagination pagination-sm" },
                        LiElementClasses = new[] { "page-item" }
                    })
                </div>
            </div>
        </div>
        <!-- shop-products-wrapper end -->
    </div>
    <div class="col-lg-3 order-2 order-lg-1">
        <!--sidebar-categores-box start  -->
        <div class="sidebar-categores-box">
            <div class="sidebar-title">
                <h2>Filter By</h2>
            </div>
            <!-- btn-clear-all start -->
            <button class="btn-clear-all mb-sm-30 mb-xs-30">Clear all</button>
            <!-- btn-clear-all end -->
            <!-- filter-sub-area start -->
            <div class="filter-sub-area">
                <h5 class="filter-sub-titel">Brand</h5>
                <div class="categori-checkbox">
                    <form action="#">
                        <ul>
                            <li><input type="checkbox" name="product-categori"><a href="#">Prime Video (13)</a></li>
                            <li><input type="checkbox" name="product-categori"><a href="#">Computers (12)</a></li>
                            <li><input type="checkbox" name="product-categori"><a href="#">Electronics (11)</a></li>
                        </ul>
                    </form>
                </div>
            </div>
            <!-- filter-sub-area end -->
            <!-- filter-sub-area start -->
            <div class="filter-sub-area pt-sm-10 pt-xs-10">
                <h5 class="filter-sub-titel">Categories</h5>
                <div class="categori-checkbox">
                    <form action="#">
                        <ul>
                            <li><input type="checkbox" name="product-categori"><a href="#">Graphic Corner (10)</a></li>
                            <li><input type="checkbox" name="product-categori"><a href="#"> Studio Design (6)</a></li>
                        </ul>
                    </form>
                </div>
            </div>
            <!-- filter-sub-area end -->
            <!-- filter-sub-area start -->
            <div class="filter-sub-area pt-sm-10 pt-xs-10">
                <h5 class="filter-sub-titel">Size</h5>
                <div class="size-checkbox">
                    <form action="#">
                        <ul>
                            <li><input type="checkbox" name="product-size"><a href="#">S (3)</a></li>
                            <li><input type="checkbox" name="product-size"><a href="#">M (3)</a></li>
                            <li><input type="checkbox" name="product-size"><a href="#">L (3)</a></li>
                            <li><input type="checkbox" name="product-size"><a href="#">XL (3)</a></li>
                        </ul>
                    </form>
                </div>
            </div>
            <!-- filter-sub-area end -->
            <!-- filter-sub-area start -->
            <div class="filter-sub-area pt-sm-10 pt-xs-10">
                <h5 class="filter-sub-titel">Color</h5>
                <div class="color-categoriy">
                    <form action="#">
                        <ul>
                            <li><span class="white"></span><a href="#">White (1)</a></li>
                            <li><span class="black"></span><a href="#">Black (1)</a></li>
                            <li><span class="Orange"></span><a href="#">Orange (3) </a></li>
                            <li><span class="Blue"></span><a href="#">Blue  (2) </a></li>
                        </ul>
                    </form>
                </div>
            </div>
            <!-- filter-sub-area end -->
            <!-- filter-sub-area start -->
            <div class="filter-sub-area pt-sm-10 pb-sm-15 pb-xs-15">
                <h5 class="filter-sub-titel">Dimension</h5>
                <div class="categori-checkbox">
                    <form action="#">
                        <ul>
                            <li><input type="checkbox" name="product-categori"><a href="#">40x60cm (6)</a></li>
                            <li><input type="checkbox" name="product-categori"><a href="#">60x90cm (6)</a></li>
                            <li><input type="checkbox" name="product-categori"><a href="#">80x120cm (6)</a></li>
                        </ul>
                    </form>
                </div>
            </div>
            <!-- filter-sub-area end -->
        </div>
        <!--sidebar-categores-box end  -->
    </div>
</div>

<script>
    function favoriEkle(e, element) {
        e.preventDefault();

        var targetUrl = $(element).attr('href');

        $.ajax({
            url: targetUrl,
            type: 'GET',
            success: function (response) {
                if (response.success) {
                    // İşlem tamamlandıktan sonra sayfayı yenile
                    location.reload();
                }
            },
            error: function () {
                alert('İşlem sırasında bir hata oluştu.');
            }
        });
    }
</script>


<style>
    /* 1. Kartı dikey flex yapıp tam boya zorluyoruz */
    .single-product-wrap {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    /* 2. Resim alanına SABİT YÜKSEKLİK verip içindekileri ortalıyoruz */
    .product-image {
        height: 280px; /* Tüm resim kutuları kesinlikle 280px olacak */
        width: 100%;
        display: flex;
        align-items: center; /* Dikeyde ortalar */
        justify-content: center; /* Yatayda ortalar */
        position: relative;
        overflow: hidden;
    }

        .product-image a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
        }

        /* 3. Resimlerin 280px dışına taşmasını engelliyor ve oranını koruyoruz */
        .product-image img {
            max-width: 100%;
            max-height: 100%;
            width: auto;
            height: auto;
            object-fit: contain;
        }

    /* 4. Alt bilgileri (başlık, fiyat, butonlar) kartın en altına hizalıyoruz */
    .product_desc {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        justify-content: space-between;
    }
    /* --- SAYFALAMA AKTİF SAYFA KESİN ÇÖZÜM --- */

    .pagination {
        display: flex;
        padding-left: 0;
        list-style: none;
        gap: 6px;
        justify-content: center;
        margin-top: 30px;
    }

        /* Normal Butonlar (Pasif) */
        .pagination li a,
        .pagination li span {
            display: block;
            padding: 8px 14px;
            color: #000000;
            background-color: #ffffff;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            text-decoration: none;
            font-weight: 600;
        }

            /* Üzerine Gelince (Hover) */
            .pagination li a:hover {
                color: #000000;
                background-color: #ffc107;
                border-color: #ffc107;
            }

        /* AKTİF SAYFA (Hangi sayfadaysan burası çalışır) */
        .pagination > .active > span,
        .pagination > .active > a,
        .pagination li.active span,
        .pagination li.active a {
            background-color: #ffc107 !important; /* Canlı Sarı */
            color: #000000 !important; /* Siyah Metin */
            border-color: #ffc107 !important; /* Sarı Kenarlık */
            font-weight: bold !important;
            box-shadow: 0 2px 6px rgba(255, 193, 7, 0.4);
            pointer-events: none;
            Tıklanamaz yapar
        }

        /* Pasif Oklar */
        .pagination li.disabled span {
            color: #6c757d;
            background-color: #f8f9fa;
            border-color: #dee2e6;
            opacity: 0.6;
        }
</style>