@model  BiliBilisim_Proje.Models.Sepet
@{
    ViewBag.Title = "sepeti_goster";
    int toplam = 0;
}

<div class="Shopping-cart-area pt-60 pb-60">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <form action="#">
                    <div class="table-content table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th class="li-product-remove">Ürünü Kaldır</th>
                                    <th class="li-product-thumbnail">images</th>
                                    <th class="cart-product-name">Product</th>
                                    <th class="li-product-price">Unit Price</th>
                                    <th class="li-product-quantity">Quantity</th>
                                    <th class="li-product-subtotal">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Sepetim)
                                {


                                    <tr>
                                        <td class="li-product-remove"><a href="@Url.Action("sepetten_sil","sepet",new {id = item.urun.urun_id })"><i class="fa fa-times"></i></a></td>
                                        <td class="li-product-thumbnail"><img src="~/Content/fotolar/@item.urun.fotolar" alt=""></td>
                                        <td class="li-product-name"><a href="@Url.Action("Details","Urunlers",new {id = item.urun.urun_id })">@(item.urun.marka + " " + @item.urun.model)</a></td>
                                        <td class="li-product-price"><span class="amount">₺@item.urun.fiyati</span></td>
                                        <td class="quantity">
                                            <label>Quantity</label>
                                            <div class="cart-plus-minus">
                                                <input class="cart-plus-minus-box" value="@item.adet" type="text">
                                                <div class="dec qtybutton"><i class="fa fa-angle-down"></i></div>
                                                <div class="inc qtybutton"><i class="fa fa-angle-up"></i></div>
                                            </div>
                                        </td>
                                        <td class="product-subtotal"><span class="amount">₺@(item.urun.fiyati * item.adet)</span></td>
                                    </tr>
                                    toplam += (int)(@item.urun.fiyati * @item.adet);
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="row">
                        <div class="col-md-5 ml-auto">
                            <div class="cart-page-total">
                                <ul>
                                    <li>Tüm Ürünlerin Toplam Fiyatı<span>₺@toplam</span></li>
                                </ul>
                                <a href="#">Satın Al</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
    @section Scripts{

    <script>
        $(document).ready(function () {

            function parseFiyat(fiyatMetin) {
                var temiz = fiyatMetin.replace('₺', '').replace(/\./g, '').replace(',', '.').trim();
                return parseFloat(temiz) || 0;
            }

            // DİKKAT: .off('click') ekleyerek temanın varsayılan +1 kodunu iptal ettik
            $('.qtybutton').off('click').on('click', function (e) {
                e.preventDefault();

                var $button = $(this);
                var $input = $button.parent().find('.cart-plus-minus-box');
                var oldValue = parseFloat($input.val()) || 1;
                var newVal;

                if ($button.hasClass('inc')) {
                    newVal = oldValue + 1;
                } else {
                    if (oldValue > 1) {
                        newVal = oldValue - 1;
                    } else {
                        newVal = 1;
                    }
                }

                $input.val(newVal);

                var $row = $button.closest('tr');

                var unitPriceText = $row.find('.li-product-price .amount').text();
                var unitPrice = parseFiyat(unitPriceText);

                var subTotal = unitPrice * newVal;

                $row.find('.product-subtotal .amount').text('₺' + subTotal);

                var grandTotal = 0;

                $('.product-subtotal .amount').each(function () {
                    var rowTotalText = $(this).text();
                    var rowTotal = parseFiyat(rowTotalText);
                    grandTotal += rowTotal;
                });

                $('.cart-page-total ul li span').text('₺' + grandTotal);
            });
        });
    </script>
}