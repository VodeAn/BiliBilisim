@model IQueryable<IGrouping<int, BiliBilisim_Proje.Models.siparisler>>

@{
    ViewBag.Title = "siparis_goster";
}


<div class="wishlist-area pt-60 pb-60">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="table-content table-responsive">
                    <table class="table">
                        @{double genel_fiyat_total = 0; }
                        @foreach (var key in Model)
                        {

                            <tr>
                                <td style="background-color:#fed700" ; colspan="5">
                                    Sipariş No: @key.Key
                                    @{
                                        var satin_alim = key.FirstOrDefault(x => x.sip_no == key.Key).a_tarih;
                                        var bugun = DateTime.Now;
                                        TimeSpan fark = bugun - satin_alim;

                                    }
                                </td>
                                <td>

                                    @if (fark.Days < 1)
                                    {
                                        @Html.ActionLink("Siparişi İptal Et", "sip_iptal", new { id = key.Key }, new { @class = "li-product-add-cart" });
                                    }

                                </td>
                            </tr>

                            <thead>
                            <th class="cart-product-name">
                                Adet
                            </th>
                            <th class="cart-product-name">
                                Sipariş Tarihi
                            </th>
                            <th class="cart-product-name">
                                Ürün Adı
                            </th>
                            <th class="li-product-thumbnail">
                                Resim
                            </th>
                            <th class="li-product-price">
                                Fiyat
                            </th>
                            <th class="li-product-stock-status">
                                İptal İşlemleri
                            </th>
                            </thead>
                            double fiyat_total = 0;
                            foreach (var item in key)
                            {
                                fiyat_total += (double)(item.adet * item.urunler.fiyati);
                                <tr>
                                    <td class="li-product-name">
                                        @Html.DisplayFor(modelItem => item.adet)
                                    </td>
                                    <td class="li-product-name">
                                        @item.a_tarih.ToShortDateString()
                                    </td>
                                    <td class="li-product-name">@Html.DisplayFor(modelItem => item.urunler.urun_adi)</td>
                                    <td class="li-product-thumbnail">
                                        <a href="#"><img src="~/Content/fotolar/@item.urunler.fotolar" style="height:250px;width:250px;" alt=""></a>
                                    </td>
                                    <td class="li-product-price">
                                        ₺@Html.DisplayFor(modelItem => item.urunler.fiyati)
                                    </td>
                                    <td>
                                        @if (fark.Days < 15)
                                        {
                                            @Html.ActionLink("ÜRÜNÜ İADE ET", "urunu_cikar", new { id = item.kayit_no }, new { @class = "li-product-add-cart" })
                                        }
                                    </td>
                                </tr>

                            }
                            <tr><td colspan="6" align="right"> <b style="font-size:16px;">Fiyat Toplamı:₺@fiyat_total</b></td></tr>
                            genel_fiyat_total += fiyat_total;
                        }
                        <tr><td colspan="6" align="right"> <b style="font-size:16px;">Genel Fiyat Toplamı:₺@genel_fiyat_total</b> </td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
